{
  "compilerOptions": {
    /* Target & Module System */
    "target": "esnext" /* Specify ECMAScript target version */,
    "module": "nodenext" /* Specify module code generation style */,
    "moduleResolution": "nodenext" /* Determine how module specifiers are resolved */,

    /* Modern Import Rules */
    "rewriteRelativeImportExtensions": true /* Map .ts extensions in imports to .js at output */,
    "verbatimModuleSyntax": true /* Do not eliminate type-only imports or exports */,
    "isolatedModules": true /* Ensure each file can be safely transpiled independently */,
    "moduleDetection": "force" /* Treat all files as modules regardless of imports/exports */,
    "noUncheckedSideEffectImports": true /* Flag typos in side-effect import paths */,
    "esModuleInterop": true /* Support importing CommonJS modules as default imports */,

    /* Output & Compilation Options */
    "rootDir": "./src" /* Specify the root folder within your input files */,
    "outDir": "./dist" /* Redirect output structure to the specified directory */,
    "noEmit": false /* Generate output files upon compilation */,
    "skipLibCheck": true /* Skip type checking of declaration files (.d.ts) */,

    /* Strict Type-Checking Options */
    "strict": true /* Enable all strict type-checking options */,
    "noUncheckedIndexedAccess": true /* Add 'undefined' to indexed access types */,
    "exactOptionalPropertyTypes": true /* Enforce strict rules for optional property types */,
    "forceConsistentCasingInFileNames": true /* Disallow casing mismatches in file references */,
    "noUnusedLocals": true /* Report errors on unused local variables */,
    "noUnusedParameters": true /* Report errors on unused function parameters */
  },
  "include": ["src/**/*"] /* Include all files inside the src directory */
}
